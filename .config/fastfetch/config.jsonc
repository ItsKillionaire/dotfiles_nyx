{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/ascii.txt",
    "color": {
      "1": "0",
    },
  },
  "display": {
    "separator": " ",
  },
  "modules": [
    // =============================================================
    // System Information
    // =============================================================
    {
      "type": "os",
      "key": " ",
      "keyColor": "34",
    },
    {
      "type": "host",
      "key": " ",
      "keyColor": "34",
    },
    {
      "type": "kernel",
      "key": " ",
      "keyColor": "34",
    },
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "34",
    },
    // Corrected packages module
    {
      "type": "packages",
      "key": " ",
      "keyColor": "34",
      "managers": ["yay"],
      "format": "{2} (yay)",
    },
    {
      "type": "separator",
      "text": "──────────────────────────────",
    },

    // =============================================================
    // Hardware
    // =============================================================
    {
      "type": "cpu",
      "key": " ",
      "keyColor": "34",
    },
    {
      "type": "gpu",
      "key": " ",
      "keyColor": "34",
    },
    {
      "type": "board",
      "key": "󰘚 ",
      "keyColor": "34",
    },
    {
      "type": "memory",
      "key": "󰍛 ",
      "keyColor": "34",
      "format": "{3} {4} {used} / {total}",
    },
    {
      "type": "disk",
      "key": " ",
      "keyColor": "34",
      "format": "{3} / {2}",
    },
    // Final, corrected display module
    {
      "type": "display",
      "key": "󰍹 ",
      "keyColor": "34",
      "format": "{name} {width}x{height}",
    },
    {
      "type": "separator",
      "text": "──────────────────────────────",
    },

    // =============================================================
    // User Environment
    // =============================================================
    {
      "type": "wm",
      "key": " ",
      "keyColor": "34",
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "34",
    },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "34",
    },
    {
      "type": "separator",
      "text": "──────────────────────────────",
    },

    // =============================================================
    // Miscellaneous
    // =============================================================
    {
      "type": "datetime",
      "format": "{11}-{3}-{1}",
      "key": " ",
      "keyColor": "34",
    },
    {
      "type": "media",
      "key": " ",
      "keyColor": "34",
    },
  ],
}
